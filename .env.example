# ==========================================
# Configuración de Produción - appcole
# ==========================================

# 1. Cloudflare Tunnel (obrigatorio se usas Cloudflare Zero Trust)
# Pega aquí o token xerado no panel de Cloudflare Zero Trust (Networks > Tunnels)
TUNNEL_TOKEN=

# 2. Almacenamento de Facturas (RustFS - Compatible con S3)
# Cambia estas credenciais por contrasinais seguros en produción
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Nome do bucket de obxectos (por defecto: facturas)
RUSTFS_BUCKET=
